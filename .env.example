# Local development: sqlite:///./parcelpulse.db
# Production example: postgresql+psycopg://USER:PASSWORD@HOST:5432/parcelpulse?sslmode=require
DATABASE_URL=sqlite:///./parcelpulse.db
CORS_ORIGINS=http://localhost:5173
APSRTC_TIMEOUT_SECONDS=12
APSRTC_MAX_RETRIES=1
MAX_UPLOAD_MB=8
ENABLE_BACKGROUND_MONITORING=false
ENVIRONMENT=development
# Generate a unique 32+ byte value for each environment; never commit the real value.
SESSION_SECRET=replace-with-a-unique-secret-before-production
AUTH_COOKIE_SECURE=false
SESSION_HOURS=12
MAX_LOGIN_FAILURES=5
LOGIN_WINDOW_MINUTES=15
# Disabled unless both values are configured outside Git. Turn this off again
# after each invited user has signed up.
SIGNUP_ENABLED=false
PRIVATE_SIGNUP_CODE=
